{
  "name": "super-feka-gaps",
  "version": "1.0.0",
  "description": "Um jogo 2D side-scroller platformer 8-bit inspirado em clássicos, 100% gerado por código",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "normalize:tiles": "tsx scripts/normalize_tiles.ts",
    "validate": "npm run validate:levels && npm run validate:player-assets",
    "validate:levels": "tsx scripts/validate_levels.ts",
    "validate:player-assets": "tsx scripts/validate_player_assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "prebuild": "npm run validate && npm run typecheck",
    "build": "vite build",
    "preview": "vite preview --host"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.3"
  },
  "keywords": [
    "game",
    "platformer",
    "8-bit",
    "canvas",
    "typescript"
  ],
  "author": "Torbware",
  "license": "MIT"
}
